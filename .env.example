# TicketScan Environment Variables
# Copy this file to .env and fill in your values
# Variables marked [REQUIRED] must be set for the app to start

# ===================
# Server Configuration
# ===================
PORT=3000
NODE_ENV=development

# ===================
# Database [REQUIRED]
# ===================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/ticketscan

# ===================
# Authentication [REQUIRED]
# ===================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_secure_random_string_here

# Admin dashboard access key (min 32 characters recommended)
ADMIN_SECRET=generate_another_secure_random_string_here

# ===================
# Ticket APIs
# ===================
# Ticketmaster: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_api_key

# SeatGeek: https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=your_seatgeek_client_id

# StubHub: https://developer.stubhub.com/
STUBHUB_APP_KEY=your_stubhub_app_key
STUBHUB_API_KEY=your_stubhub_api_key

# Vivid Seats (optional)
VIVIDSEATS_API_KEY=

# ===================
# Email (SMTP) [REQUIRED for email features]
# ===================
# SiteGround: mail.yourdomain.com, port 465 (SSL) or 587 (TLS)
# Gmail: smtp.gmail.com, port 587, use App Password
SMTP_HOST=mail.ticketscan.io
SMTP_PORT=465
SMTP_USER=noreply@ticketscan.io
SMTP_PASS=your_email_password

# ===================
# Twitter/X API (for automated posting)
# ===================
# Get credentials at: https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ===================
# ===================
# Typefully API (for Twitter posting — bypasses Twitter Free tier write restrictions)
# ===================
# Sign up at https://typefully.com → Settings → API → Generate API key
# TYPEFULLY_SOCIAL_SET_ID is auto-detected on first use if not set
TYPEFULLY_API_KEY=your_typefully_api_key
TYPEFULLY_SOCIAL_SET_ID=

# ===================
# Instagram API with Instagram Login (for automated posting)
# ===================
# Uses graph.instagram.com (not graph.facebook.com)
# Requires: Instagram Business/Creator account + Meta App with Instagram Business Login
# Get token: https://developers.facebook.com/ → Your App → Instagram Business Login → Generate Token
# Refresh token (60 days): GET https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=TOKEN
# Permissions needed: instagram_business_basic, instagram_business_content_publish
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_token
INSTAGRAM_ACCOUNT_ID=your_instagram_user_id

# ===================
# Frontend URL (for email links)
# ===================
FRONTEND_URL=https://www.ticketscan.io

# Blotato API (multi-platform social posting)
BLOTATO_API_KEY=your_blotato_api_key
