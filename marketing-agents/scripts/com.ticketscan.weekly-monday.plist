<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ticketscan.weekly-monday</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/XAMPP/xamppfiles/htdocs/Sites/ticketscan/marketing-agents/scripts/run-weekly-monday.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Applications/XAMPP/xamppfiles/htdocs/Sites/ticketscan/marketing-agents/logs/launchd-weekly-mon-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Applications/XAMPP/xamppfiles/htdocs/Sites/ticketscan/marketing-agents/logs/launchd-weekly-mon-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/samir/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/samir</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
